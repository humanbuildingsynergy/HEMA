  "automation_rules": [
    {
      "rule_id": "dr_precool",
      "name": "Pre-cool Before Peak",
      "trigger": {
        "type": "time",
        "value": "14:00"
      },
      "conditions": [
        {
          "device": "hvac",
          "property": "mode",
          "operator": "equals",
          "value": "cool"
        }
      ],
      "actions": [
        {
          "device": "hvac",
          "action": "set_temperature",
          "params": {
            "target_temp_f": 72
          }
        }
      ],
      "description": "Pre-cool house before TOU peak period (3-8pm)"
    },
    {
      "rule_id": "dr_peak_setback",
      "name": "Peak Hour Setback",
      "trigger": {
        "type": "time",
        "value": "15:00"
      },
      "conditions": [],
      "actions": [
        {
          "device": "hvac",
          "action": "set_temperature",
          "params": {
            "target_temp_f": 78
          }
        }
      ],
      "description": "Raise setpoint during TOU peak period"
    },
    {
      "rule_id": "ev_offpeak",
      "name": "EV Off-Peak Charging",
      "trigger": {
        "type": "time",
        "value": "22:00"
      },
      "conditions": [
        {
          "device": "ev_charger",
          "property": "vehicle_connected",
          "operator": "equals",
          "value": true
        }
      ],
      "actions": [
        {
          "device": "ev_charger",
          "action": "start_charging",
          "params": {}
        }
      ],
      "description": "Start EV charging at off-peak rate start"
    },
    {
      "rule_id": "pool_offpeak",
      "name": "Pool Pump Off-Peak Schedule",
      "trigger": {
        "type": "time",
        "value": "05:00"
      },
      "conditions": [],
      "actions": [
        {
          "device": "pool_pump",
          "action": "set_preset",
          "params": {
            "preset_name": "low"
          }
        }
      ],
      "description": "Run pool pump at low speed during off-peak hours"
    },
    {
      "rule_id": "solar_ev",
      "name": "Solar Excess to EV",
      "trigger": {
        "type": "condition",
        "device": "solar_system",
        "property": "grid_export_kw",
        "operator": "greater_than",
        "value": 3.0
      },
      "conditions": [
        {
          "device": "ev_charger",
          "property": "vehicle_connected",
          "operator": "equals",
          "value": true
        }
      ],
      "actions": [
        {
          "device": "ev_charger",
          "action": "start_charging",
          "params": {
            "rate_kw": 4.8
          }
        }
      ],
      "description": "Use excess solar production to charge EV"
    }
